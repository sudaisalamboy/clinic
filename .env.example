# Clinic Management System - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# Database (SQLite; use a relative path in production)
DATABASE_URL="file:./db/custom.db"

# JWT signing secret for session tokens (long random string in prod).
# REQUIRED in production — the server refuses to boot without it.
# Generate one with: openssl rand -hex 32
AUTH_JWT_SECRET=<long-random-string>
# AUTH_JWT_ISSUER=clinic
# AUTH_JWT_AUDIENCE=clinic-web

# First-run setup
# ---------------
# There is NO env-based default admin. On first launch the app shows a
# Setup screen (or you can POST /api/auth/setup) where the operator picks
# the admin email + a strong password (min 12 chars, mixed case + digit).
# Passwords are argon2id-hashed and never logged in plain text.
